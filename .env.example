# Vite dev server
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173

# Backend API target used by Vite proxy
VITE_API_TARGET=http://127.0.0.1:8080

# Optional absolute base URL for files under /uploads
# Leave empty to use same-origin path through the dev proxy
VITE_FILE_BASE_URL=

# Optional public frontend URL override for copied share links / QR codes
# Leave empty to use the current browser origin
VITE_PUBLIC_ORIGIN=
